# Server-only state, and the one place secrets live.
# data/rules/*.json carry live site cookies (exhentai ipb_pass_hash/igneous, sankaku
# session). deploy.sh already refuses to sync this directory for the same reason —
# rules and the library exist only on the server. Redacted copies of the rules, which
# are the part actually worth keeping, live in rules.example/.
data/

node_modules/

# Build output: dist/shadowplay.html is generated by `npm run build:standalone`.
# It was MADE a build output precisely so it could never drift from the web player —
# committing it would hand that footgun straight back.
dist/

# Local scratch
tmp/
*.log
.playwright-mcp/
.agents/
.codex/
